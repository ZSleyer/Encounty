{
  "name": "encounty",
  "version": "0.22.0",
  "description": "Free, open-source auto shiny counter for Pokémon shiny hunting.",
  "author": "ZSleyer",
  "license": "AGPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
