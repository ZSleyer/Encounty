    "package:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "resolutions": {
    "js-yaml": "4.3.1"
  }
