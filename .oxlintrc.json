{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-nested-ternary": "error",
    "eslint/no-negated-condition": "error",
    "vitest/require-mock-type-parameters": "off",
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "typescript/no-explicit-any": "off",
    "eslint/no-unused-vars": "off",
    "typescript/no-unused-vars": "off",

    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/no-unstable-nested-components": "off",
    "react/immutability": "off",
    "react/memo-dependencies": "off",
    "react/hooks": "off",
    "react/no-array-index-key": "off",
    "react/no-object-type-as-default-prop": "off",
    "react-hooks/exhaustive-deps": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-set-has": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-new": "off",
    "promise/always-return": "off",
    "oxc/no-map-spread": "off",
    "import/no-unassigned-import": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/expect-expect": "off",
    "vitest/require-to-throw-message": "off",

    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/click-events-have-key-events": "off",

    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "import/no-named-as-default-member": "off",
    "vitest/valid-title": "off",
    "promise/no-callback-in-promise": "off",
    "react/no-children-prop": "off",
    "react/purity": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/preserve-manual-memoization": "off",

    // Zero cycles in the tree as of the split, so this stays a ratchet.
    "import/no-cycle": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "backend/**",
    "graphify-out/**",
    "frontend/public/**",
    "site/public/**"
  ],
  "overrides": [
    {
      // Fixtures and table-driven assertions read fine as nested ternaries; the
      // rule's readability argument is about production branching.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test-utils.tsx", "**/__tests__/**"],
      "rules": {
        "eslint/no-nested-ternary": "off"
      }
    },
    {
      "files": ["electron/**/*.ts"],
      "env": { "browser": false, "node": true }
    }
  ]
}
